#!/usr/bin/env sh
# MetaSearch Mandatory Pre-Commit Quality & End-to-End Test Gate
# Blocks any git commit if unit tests, E2E tests, ruff, or bandit fail.

set -e

# Local runtime data (SQLite DBs, retention markers, api/.env.*) must never reach the public
# repo, even with `git add -f` (AGENTS.md, "Local runtime data").
LOCAL_DATA=$(git diff --cached --name-only --diff-filter=ACMR |
    grep -E '(\.db|\.db-wal|\.db-shm|\.sqlite3|\.retention)$|(^|/)\.env\.[^/]+$' |
    grep -vE '\.example$' || true)
if [ -n "$LOCAL_DATA" ]; then
    echo "==> [Pre-Commit Gate] BLOCKED: local runtime data is staged (live keys/users/history):"
    echo "$LOCAL_DATA" | sed 's/^/    /'
    echo "    Unstage with: git restore --staged <file>   (do NOT delete the file)"
    exit 1
fi

echo "==> [Pre-Commit Gate] Running mandatory Unit + End-to-End (E2E) verification before commit..."

if [ -x "api/.venv/Scripts/python.exe" ]; then
    PYTHON_BIN="api/.venv/Scripts/python.exe"
elif [ -x "api/.venv/bin/python" ]; then
    PYTHON_BIN="api/.venv/bin/python"
elif [ -x "api/.venv/bin/python3" ]; then
    PYTHON_BIN="api/.venv/bin/python3"
elif command -v python3 >/dev/null 2>&1; then
    PYTHON_BIN="python3"
else
    PYTHON_BIN="python"
fi

"$PYTHON_BIN" scripts/release.py --pre-commit-gate
