# MetaSearch — LITE profile (không cần Docker, chạy native trên Windows/Linux)
# Dành cho máy yếu: API ~100MB RAM, không container, không browser.
# Copy thành .env đặt cạnh docker-compose.yml HOẶC trong thư mục api/.env khi chạy uvicorn.
# Xem docs/08-deployment.md §"Lite profile".

# ── Search engines (keyless trước, key khi có) ────────────────────────
# Tắt SearXNG (cần Docker) — DuckDuckGo keyless + 14 vertical engines thay thế.
SEARXNG_ENABLED=false
# Các engine có API key sẽ tự bật khi điền key (chọn 1 nếu muốn chất lượng cao hơn):
TAVILY_API_KEY=
SERPER_API_KEY=
BRAVE_API_KEY=
GITHUB_TOKEN=

# ── Storage: SQLite thay Postgres+pgvector ────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./metasearch.db
# L2 semantic cache cần pgvector -> tắt trên Lite (L1 cache vẫn chạy).
EMBEDDING_L2=off

# ── Redis: không cần — cache + rate limit tự fallback in-process ──────
REDIS_URL=redis://127.0.0.1:6399/0   # port giả: sẽ miss/fallback
CACHE_ENABLED=true

# ── Extraction: trafilatura in-process + Jina Reader keyless (~20 rpm) ─
CRAWL4AI_URL=http://127.0.0.1:1      # không có -> tự bỏ qua tier này
JINA_KEYLESS=true
JINA_API_KEY=                        # điền key để tăng rate ceiling

# ── LLM Miễn Phí (20 Presets) & Hội Đồng Phán Quyết (Council + Dream-RSI) ──
# Danh mục tổng hợp từ OpenRouter Free, nejib1/Free-LLM & awesome-freellm-apis.
# Chọn: openrouter | pollinations | gemini | groq | nvidia_nim | cerebras |
#       sambanova | mistral | github_models | cloudflare | cohere | chutes |
#       siliconflow | hyperbolic | huggingface | ollama | custom | openai | anthropic | none
#
# Cách 1 (Khuyến nghị): OpenRouter Free Router (https://openrouter.ai/openrouter/free)
# $0/M input & output — tự động chọn model free tốt nhất (Llama 3.3 70B, DeepSeek R1/V3, Gemini 2.0):
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
LLM_QUICK_MODEL=openrouter/free
LLM_REPORT_MODEL=openrouter/free
# Tự động fallback sang Pollinations (keyless 100% miễn phí) nếu chưa điền OPENROUTER_API_KEY:
LLM_FALLBACK_PROVIDER=pollinations

# Hội đồng Phán quyết (gọi nhiều Free LLM song song + Cross-Review + Dream-RSI):
LLM_COUNCIL_ENABLED=false
LLM_COUNCIL_ENDPOINTS=openrouter:openrouter/free,pollinations:openai,groq:llama-3.3-70b-versatile,gemini:gemini-2.0-flash
LLM_DREAM_RSI_ENABLED=true

# Cách 2: Các nguồn Free LLM uy tín từ nejib1/Free-LLM & awesome-freellm-apis:
GEMINI_API_KEY=                      # https://aistudio.google.com/apikey (LLM_PROVIDER=gemini)
GROQ_API_KEY=                        # https://console.groq.com/keys (LLM_PROVIDER=groq)
NVIDIA_NIM_API_KEY=                  # https://build.nvidia.com (LLM_PROVIDER=nvidia_nim)
CEREBRAS_API_KEY=                    # https://cloud.cerebras.ai (LLM_PROVIDER=cerebras)
SAMBANOVA_API_KEY=                   # https://cloud.sambanova.ai (LLM_PROVIDER=sambanova)
MISTRAL_API_KEY=                     # https://console.mistral.ai (LLM_PROVIDER=mistral)
COHERE_API_KEY=                      # https://dashboard.cohere.com (LLM_PROVIDER=cohere)
CHUTES_API_KEY=                      # https://chutes.ai (LLM_PROVIDER=chutes)
SILICONFLOW_API_KEY=                 # https://cloud.siliconflow.cn (LLM_PROVIDER=siliconflow)
HYPERBOLIC_API_KEY=                  # https://app.hyperbolic.xyz (LLM_PROVIDER=hyperbolic)
HF_TOKEN=                            # https://huggingface.co/settings/tokens (LLM_PROVIDER=huggingface)

# Cách 3: Ollama / vLLM / LM Studio chạy local (LLM_PROVIDER=ollama):
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# Cách 4: Kết nối vào hệ thống khác đã có sẵn LLM nội bộ (LLM_PROVIDER=custom):
CUSTOM_LLM_PROTOCOL=openai
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_HEADERS=

# ── Auth (tắt mặc định cho local) ─────────────────────────────────────
AUTH_ENABLED=false

# ── Search budget (máy yếu: giữ khiêm tốn) ────────────────────────────
SCRAPE_CONCURRENCY=3
SEARCH_FANOUT_BUDGET_S=6
