# MetaSearch — environment template (copy thành .env, KHÔNG commit .env)
# Xem docs/08-deployment.md §3.

# ── Authentication (bắt buộc khi chạy compose / bind public 0.0.0.0) ───
AUTH_ENABLED=true

# ── Core services (bắt buộc) ─────────────────────────────────────────
SEARXNG_URL=http://searxng:8080
CRAWL4AI_URL=http://crawl4ai:11222
DATABASE_URL=postgresql+asyncpg://metasearch:metasearch@postgres:5432/metasearch
REDIS_URL=redis://redis:6379/0

# ── Postgres (dùng bởi compose) ──────────────────────────────────────
POSTGRES_USER=metasearch
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=metasearch

# ── SearXNG ──────────────────────────────────────────────────────────
# Sinh secret: python -c "import secrets; print(secrets.token_hex(32))"
SEARXNG_SECRET=change-me-random-hex

# ── LLM Gateway (OpenRouter Free / 20 Presets / Multi-Endpoint Council + Dream-RSI) ──
# Danh mục tổng hợp từ:
# - https://openrouter.ai/openrouter/free
# - https://github.com/nejib1/Free-LLM
# - https://github.com/open-free-llm-api/awesome-freellm-apis
#
# Chọn provider: openrouter | pollinations | gemini | groq | nvidia_nim | cerebras |
#                sambanova | mistral | github_models | cloudflare | cohere | chutes |
#                siliconflow | hyperbolic | huggingface | ollama | custom | openai |
#                anthropic | none
#
# 1) Khuyến nghị miễn phí #1: OpenRouter Free Router (https://openrouter.ai/openrouter/free)
#    Tự động định tuyến tới Llama 3.3 70B, DeepSeek V3/R1, Gemini 2.0 Flash, Qwen 2.5 72B ($0/M).
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_QUICK_MODEL=openrouter/free
LLM_REPORT_MODEL=openrouter/free
# Tự động fallback sang Pollinations (keyless free) nếu chưa có key hoặc hết quota:
LLM_FALLBACK_PROVIDER=pollinations

# 2) Hội đồng Phán quyết (LLM Council + Cross-Review + Dream-RSI Replay):
#    Gọi đồng thời nhiều endpoint free, ẩn danh Candidate A/B/C để chấm chéo & tổng hợp bởi Chairman:
LLM_COUNCIL_ENABLED=false
LLM_COUNCIL_ENDPOINTS=openrouter:openrouter/free,pollinations:openai,groq:llama-3.3-70b-versatile,gemini:gemini-2.0-flash
LLM_DREAM_RSI_ENABLED=true

# 3) Các nguồn LLM miễn phí uy tín từ nejib1/Free-LLM & awesome-freellm-apis:
# - Google Gemini AI Studio Free Tier (https://aistudio.google.com/apikey):
GEMINI_API_KEY=
# - Groq Cloud LPU Free Tier (https://console.groq.com/keys):
GROQ_API_KEY=
# - NVIDIA NIM Developer Free Credits (https://build.nvidia.com):
NVIDIA_NIM_API_KEY=
# - Cerebras Wafer-Scale Free Tier (https://cloud.cerebras.ai):
CEREBRAS_API_KEY=
# - SambaNova Cloud RDU Free Tier (https://cloud.sambanova.ai):
SAMBANOVA_API_KEY=
# - Mistral La Plateforme Experiment Free Tier (https://console.mistral.ai/api-keys):
MISTRAL_API_KEY=
# - Cohere Trial API Key (https://dashboard.cohere.com/api-keys):
COHERE_API_KEY=
# - Chutes.ai Decentralized Serverless Free AI (https://chutes.ai):
CHUTES_API_KEY=
# - SiliconFlow Free Models Tier (https://cloud.siliconflow.cn):
SILICONFLOW_API_KEY=
# - Hyperbolic AI Starter Credits (https://app.hyperbolic.xyz):
HYPERBOLIC_API_KEY=
# - Cloudflare Workers AI Free Tier (https://dash.cloudflare.com):
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_KEY=
# - HuggingFace Inference Router (https://huggingface.co/settings/tokens):
HF_TOKEN=
# - GitHub Models (dùng chung GITHUB_TOKEN bên dưới)
# - Pollinations AI (LLM_PROVIDER=pollinations — KHÔNG cần API key)
# - Local Ollama / vLLM / LM Studio (LLM_PROVIDER=ollama):
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# 4) Tích hợp với hệ thống khác đã có sẵn LLM nội bộ (LLM_PROVIDER=custom):
#    Trỏ vào LiteLLM Proxy, vLLM Cluster, Kong AI Gateway, Azure OpenAI, v.v.
CUSTOM_LLM_PROTOCOL=openai      # openai | anthropic
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_HEADERS=             # JSON object, vd: {"X-Tenant-Id":"fin-prod"}

# 5) OpenAI / Anthropic trả phí truyền thống:
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Context budget cho /v1/answer & /v1/context (đơn vị theo CONTEXT_TOKENIZER)
ANSWER_CONTEXT_BUDGET=6000
CONTEXT_TOKENIZER=words         # words (mặc định) | tiktoken (cần: pip install '.[tokens]')

# ── Search engines phụ (tuỳ chọn — SearXNG là primary) ───────────────
TAVILY_API_KEY=
SERPER_API_KEY=
BRAVE_API_KEY=
GITHUB_TOKEN=

# ── Extraction fallback tầng 3 (tuỳ chọn) ────────────────────────────
JINA_API_KEY=

# ── crawl4ai server token (tuỳ chọn, khuyến nghị đặt) ────────────────
CRAWL4AI_API_TOKEN=

# ── Phase 2: cache (Redis phải chạy — xem docker-compose) ────────────
CACHE_ENABLED=true
CACHE_SEARCH_TTL_S=1800         # 15-60 phút (docs/03 §7)
CACHE_NEWS_TTL_S=900            # news 15 phút
CACHE_ANSWER_TTL_S=7200         # 1-6 giờ
CACHE_PAGE_TTL_S=43200          # 6-24 giờ

# ── Phase 2: reranker ─────────────────────────────────────────────────
RERANKER=heuristic              # heuristic (0ms) | onnx (~300MB) | api (Jina)
RERANKER_API_BASE_URL=https://api.jina.ai
# Thư mục chứa model.onnx + tokenizer.json (jina-reranker-v2 int8)
RERANKER_ONNX_DIR=

# ── Phase 2: L2 semantic cache (mặc định tắt trên máy 16GB) ──────────
EMBEDDING_L2=off                # off | bge-m3-api (qua /embeddings OpenAI-compatible)
EMBEDDING_API_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=bge-m3          # bắt buộc 1024 dims để khớp pgvector

# ── Phase 2: engine management ────────────────────────────────────────
REGISTRY_REFRESH_S=5            # đọc lại bảng engines mỗi N giây (hot config)
ENGINE_AUTO_DISABLE_THRESHOLD=3 # lỗi liên tiếp -> auto disable
ENGINE_RECOVERY_PROBE_S=300     # worker probe engine bị disable mỗi 5 phút
ENGINE_STORE_BACKEND=db         # db (Postgres + fallback memory) | memory (dev/perf không DB)
ENGINE_STORE_DB_TIMEOUT_S=0.5   # op DB của engine store tối đa bao lâu trước khi fallback

# ── Tuỳ chọn quan sát ─────────────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# ── Observability profile ────────────────────────────────────────────
GRAFANA_PASSWORD=admin

# ── Server-side TTS: VoiceStudio (tuỳ chọn, profile "tts", docs/17) ────
# Để trống VOICESTUDIO_URL = TẮT tính năng, Web UI dùng Web Speech API của
# trình duyệt (mặc định, không cần model). Bật trong compose:
#   docker compose --profile tts up -d voicestudio
# và đặt URL tới service trong mạng compose:
#VOICESTUDIO_URL=http://voicestudio:3900
# Chạy local không Docker (VoiceStudio trên máy host): VOICESTUDIO_URL=http://127.0.0.1:3900
VOICESTUDIO_URL=
VOICESTUDIO_API_KEY=
VOICESTUDIO_MODEL=omnivoice
VOICESTUDIO_VOICE=

# ── v2.3.0: so sánh mã + biểu đồ nến + watchlist + podcast (docs/18) ──
# Tất cả đều có default an toàn — chỉ cần set khi muốn đổi.
#FA_COMPARE_MAX_SYMBOLS=5        # số mã tối đa mỗi lần POST /v1/fa/compare
#FA_COMPARE_TIMEOUT_S=8
#MARKET_OHLCV_MIN_DAYS=30        # cửa sổ nến /v1/market/ohlcv
#MARKET_OHLCV_MAX_DAYS=365
#MARKET_OHLCV_DEFAULT_DAYS=90
#MARKET_OHLCV_TIMEOUT_S=5
#WATCHLIST_MAX_ITEMS=20          # số query theo dõi mỗi API key
#WATCHLIST_ALERTS_K=5            # số tin mỗi item khi poll /v1/watchlist/alerts
#WATCHLIST_ALERTS_FRESHNESS_DAYS=1
#WATCHLIST_ALERTS_TIMEOUT_MS=8000
#WATCHLIST_ALERTS_TOTAL_TIMEOUT_S=30   # cap tổng một lần poll (fan-out song song bên trong)
#WATCHLIST_ALERTS_CONCURRENCY=4
#PODCAST_RETENTION_DAYS=7        # giữ đúng N ngày file bản tin trong api/podcast_data/
#PODCAST_MAX_CHARS=4000          # cap script đọc (cắt ở boundary câu)
#PODCAST_ITEMS_PER_CATEGORY=3
#PODCAST_TIMEOUT_S=120
#PODCAST_SEARCH_TIMEOUT_MS=8000
#PUBLIC_BASE_URL=                # origin công khai cho enclosure RSS (sau reverse proxy); để trống = theo request
#GLOBAL_SEARCH_MAILTO=         # polite-pool contact cho OpenAlex/Crossref (docs/19), để trống cũng được

# ── v2.5.0 retrieval quality (docs/20 P0 wave) ────────────────────────
# P0-2: RERANKER=bge dùng bge-reranker-v2-m3 local ONNX (int8 nếu có);
# tự tải từ HF về MODEL_CACHE_DIR lần đầu (cần huggingface_hub + network).
BGE_RERANKER_DIR=               # thư mục local chứa model.onnx/model_int8.onnx + tokenizer.json (để trống = tự tải)
BGE_RERANKER_HF_REPO=BAAI/bge-reranker-v2-m3
MODEL_CACHE_DIR=                # gốc cache model (để trống = ~/.cache/metasearch/models)
# P0-1: trọng số tín hiệu RRF trong điểm hợp nhất (0 = tắt)
RRF_WEIGHT=0.3
# P0-3: mở rộng truy vấn thành nhiều biến thể (chỉ ở deep hoặc câu dài) rồi fuse bằng RRF
QUERY_EXPANSION_ENABLED=true
QUERY_EXPANSION_MAX_VARIANTS=2
QUERY_EXPANSION_MIN_WORDS=6
# P0-4: kiểm tra từng câu trả lời có được chunk trích dẫn hỗ trợ không (lexical; NLI model optional)
CLAIM_CHECK_ENABLED=true
CLAIM_ENTAILMENT_THRESHOLD=0.34
CITATION_NLI_ENABLED=false
CITATION_NLI_DIR=
# P0-5: gợi ý câu hỏi tiếp theo sau mỗi câu trả lời
FOLLOWUPS_ENABLED=true
FOLLOWUPS_MAX=3
# P0-6: boost theo key (CRUD /v1/prefs/boosts), số rule tối đa mỗi key
BOOSTS_MAX_PER_KEY=50
# P0-7: extras cho agent trên /v1/search (extras=contents,highlights,answer)
SEARCH_EXTRAS_MAX_URLS=5
SEARCH_EXTRAS_MAX_CHARS=4000
SEARCH_HIGHLIGHTS_MAX=2


# ── v2.6.0 wave P1 deep intelligence (docs/20 §4 P1 → docs/22) ─────────
# P1-8: half-life (ngày) của điểm freshness — news giữ đúng legacy (30*ln2≈20.794), non-news 45 ngày
FRESHNESS_HALF_LIFE_DAYS_NEWS=20.794
FRESHNESS_HALF_LIFE_DAYS_OTHER=45.0
# P1-2: tự động route câu đa hop / so sánh / dài sang deep fan-out
ADAPTIVE_ROUTER_ENABLED=true
ADAPTIVE_ROUTER_MIN_WORDS_DEEP=14
# P1-1: vòng research IRCoT — reformulate theo evidence + coverage gate
RESEARCH_IRCOT_REFORMULATE=true
RESEARCH_COVERAGE_GATE_ENABLED=true
RESEARCH_COVERAGE_THRESHOLD=0.6
# P1-5: memory theo key (CRUD /v1/memory; DELETE xoá toàn bộ — privacy)
MEMORY_ENABLED=true
MEMORY_MAX_PER_KEY=500
MEMORY_FEEDBACK_BOOST=0.15
# P1-6: Spaces (CRUD /v1/spaces, search với space=<slug>)
SPACES_ENABLED=true
SPACES_MAX_PER_KEY=20
# P1-7: /v1/map + /v1/crawl
MAP_MAX_URLS=200
CRAWL_MAX_PAGES=50
CRAWL_MAX_DEPTH=2
# P1-3: late chunking cho doc dài (cần EMBEDDING_L2 khác off để embed)
LATE_CHUNKING_ENABLED=true
LATE_CHUNKING_DOC_MAX_CHARS=24000
LATE_CHUNKING_SEGMENT_CHARS=6000
LATE_CHUNKING_SEGMENT_OVERLAP_CHARS=300
# P1-4: hybrid dense+sparse chunk search (POST /v1/hybrid)
HYBRID_SEARCH_ENABLED=true
HYBRID_RRF_WEIGHT=0.5

# ── v3.0.0 wave P2 (docs/20 §4 P2 → docs/24) ─────────────────────────────
# P2-4: online interleaving — A/B hash-bucket theo (query, owner); treatment chạy
# với RRF weight riêng; số liệu theo variant ở GET /v1/ops/interleave
#INTERLEAVE_ENABLED=true
#INTERLEAVE_RATIO=0.5
#INTERLEAVE_TREATMENT_RRF_WEIGHT=0.5
#INTERLEAVE_SALT=v3
# P2-1: PDF page-level retrieval (pypdf) + vision embed API (tuỳ chọn, để trống = text-only)
#PDF_MAX_PAGES=60
#VISION_EMBED_API_BASE_URL=          # vd https://api.jina.ai/v1 — chỉ http(s)
#VISION_EMBED_MODEL=jina-embeddings-v4
# P2-2: knowledge graph theo Space (POST /v1/spaces/{slug}/graph/build|query)
#KG_ENABLED=true
#KG_MAX_DOCS_PER_BUILD=20
#KG_MAX_NODES_PER_BUILD=200
# P2-5: podcast cá nhân hoá theo watchlist (POST /v1/podcast/personal)
#PODCAST_PERSONAL_ENABLED=true

# ── v3.1.0 Web UI static mount (docs/08) ─────────────────────────────────
# API có thể tự phục vụ frontend/out tại "/" (build: cd frontend && npm run
# build:export). Bản Docker dùng UI riêng trên :3000 nên để nguyên như cũ
# (image API không có frontend/out nên mount tự bỏ qua).
#SERVE_UI=true
#UI_STATIC_DIR=                    # trống = tự nhận <repo>/frontend/out
