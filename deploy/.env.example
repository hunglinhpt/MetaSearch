# MetaSearch — environment template (copy thành .env, KHÔNG commit .env)
# Xem docs/08-deployment.md §3.

# ── Core services (bắt buộc) ─────────────────────────────────────────
SEARXNG_URL=http://searxng:8080
CRAWL4AI_URL=http://crawl4ai:11222
DATABASE_URL=postgresql+asyncpg://metasearch:metasearch@postgres:5432/metasearch
REDIS_URL=redis://redis:6379/0

# ── Postgres (dùng bởi compose) ──────────────────────────────────────
POSTGRES_USER=metasearch
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=metasearch

# ── SearXNG ──────────────────────────────────────────────────────────
# Sinh secret: python -c "import secrets; print(secrets.token_hex(32))"
SEARXNG_SECRET=change-me-random-hex

# ── LLM Gateway (OpenRouter Free / Multi-Provider / BYO-LLM) ─────────
# Chọn provider: openrouter | pollinations | gemini | groq | cerebras |
#                mistral | github_models | huggingface | ollama | custom |
#                openai | anthropic | none
#
# 1) Khuyến nghị miễn phí #1: OpenRouter Free Router (https://openrouter.ai/openrouter/free)
#    Tự động định tuyến tới Llama 3.3 70B, DeepSeek V3/R1, Gemini 2.0 Flash, Qwen 2.5 72B ($0/M).
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_QUICK_MODEL=openrouter/free
LLM_REPORT_MODEL=openrouter/free
# Tự động fallback sang Pollinations (keyless free) nếu chưa có key hoặc hết quota:
LLM_FALLBACK_PROVIDER=pollinations

# 2) Các nguồn LLM miễn phí uy tín khác (điền key và đổi LLM_PROVIDER tương ứng):
# - Google Gemini AI Studio Free Tier (https://aistudio.google.com/apikey):
GEMINI_API_KEY=
# - Groq Cloud LPU Free Tier (https://console.groq.com/keys):
GROQ_API_KEY=
# - Cerebras Wafer-Scale Free Tier (https://cloud.cerebras.ai):
CEREBRAS_API_KEY=
# - Mistral La Plateforme Experiment Free Tier (https://console.mistral.ai/api-keys):
MISTRAL_API_KEY=
# - HuggingFace Inference Router (https://huggingface.co/settings/tokens):
HF_TOKEN=
# - GitHub Models (dùng chung GITHUB_TOKEN bên dưới)
# - Pollinations AI (LLM_PROVIDER=pollinations — KHÔNG cần API key)
# - Local Ollama / vLLM / LM Studio (LLM_PROVIDER=ollama):
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# 3) Tích hợp với hệ thống khác đã có sẵn LLM nội bộ (LLM_PROVIDER=custom):
#    Trỏ vào LiteLLM Proxy, vLLM Cluster, Kong AI Gateway, Azure OpenAI, v.v.
CUSTOM_LLM_PROTOCOL=openai      # openai | anthropic
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_HEADERS=             # JSON object, vd: {"X-Tenant-Id":"fin-prod"}

# 4) OpenAI / Anthropic trả phí truyền thống:
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Context budget cho /v1/answer & /v1/context (đơn vị theo CONTEXT_TOKENIZER)
ANSWER_CONTEXT_BUDGET=6000
CONTEXT_TOKENIZER=words         # words (mặc định) | tiktoken (cần: pip install '.[tokens]')

# ── Search engines phụ (tuỳ chọn — SearXNG là primary) ───────────────
TAVILY_API_KEY=
SERPER_API_KEY=
BRAVE_API_KEY=
GITHUB_TOKEN=

# ── Extraction fallback tầng 3 (tuỳ chọn) ────────────────────────────
JINA_API_KEY=

# ── crawl4ai server token (tuỳ chọn, khuyến nghị đặt) ────────────────
CRAWL4AI_API_TOKEN=

# ── Phase 2: cache (Redis phải chạy — xem docker-compose) ────────────
CACHE_ENABLED=true
CACHE_SEARCH_TTL_S=1800         # 15-60 phút (docs/03 §7)
CACHE_NEWS_TTL_S=900            # news 15 phút
CACHE_ANSWER_TTL_S=7200         # 1-6 giờ
CACHE_PAGE_TTL_S=43200          # 6-24 giờ

# ── Phase 2: reranker ─────────────────────────────────────────────────
RERANKER=heuristic              # heuristic (0ms) | onnx (~300MB) | api (Jina)
RERANKER_API_BASE_URL=https://api.jina.ai
# Thư mục chứa model.onnx + tokenizer.json (jina-reranker-v2 int8)
RERANKER_ONNX_DIR=

# ── Phase 2: L2 semantic cache (mặc định tắt trên máy 16GB) ──────────
EMBEDDING_L2=off                # off | bge-m3-api (qua /embeddings OpenAI-compatible)
EMBEDDING_API_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=bge-m3          # bắt buộc 1024 dims để khớp pgvector

# ── Phase 2: engine management ────────────────────────────────────────
REGISTRY_REFRESH_S=5            # đọc lại bảng engines mỗi N giây (hot config)
ENGINE_AUTO_DISABLE_THRESHOLD=3 # lỗi liên tiếp -> auto disable
ENGINE_RECOVERY_PROBE_S=300     # worker probe engine bị disable mỗi 5 phút
ENGINE_STORE_BACKEND=db         # db (Postgres + fallback memory) | memory (dev/perf không DB)
ENGINE_STORE_DB_TIMEOUT_S=0.5   # op DB của engine store tối đa bao lâu trước khi fallback

# ── Tuỳ chọn quan sát ─────────────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# ── Observability profile ────────────────────────────────────────────
GRAFANA_PASSWORD=admin
