# MetaSearch — environment template (copy thành .env, KHÔNG commit .env)
# Xem docs/08-deployment.md §3.

# ── Core services (bắt buộc) ─────────────────────────────────────────
SEARXNG_URL=http://searxng:8080
CRAWL4AI_URL=http://crawl4ai:11222
DATABASE_URL=postgresql+asyncpg://metasearch:metasearch@postgres:5432/metasearch
REDIS_URL=redis://redis:6379/0

# ── Postgres (dùng bởi compose) ──────────────────────────────────────
POSTGRES_USER=metasearch
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=metasearch

# ── SearXNG ──────────────────────────────────────────────────────────
# Sinh secret: python -c "import secrets; print(secrets.token_hex(32))"
SEARXNG_SECRET=change-me-random-hex

# ── LLM (bắt buộc ít nhất 1) ─────────────────────────────────────────
# Quick answer: gpt-4o-mini / claude-haiku · Report: gpt-4o / claude-sonnet
LLM_PROVIDER=openai            # openai | anthropic
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Search engines phụ (tuỳ chọn — SearXNG là primary) ───────────────
TAVILY_API_KEY=
SERPER_API_KEY=
BRAVE_API_KEY=

# ── Extraction fallback tầng 3 (tuỳ chọn) ────────────────────────────
JINA_API_KEY=

# ── crawl4ai server token (tuỳ chọn, khuyến nghị đặt) ────────────────
CRAWL4AI_API_TOKEN=

# ── Tuỳ chọn chất lượng / quan sát ───────────────────────────────────
RERANKER=heuristic            # heuristic (mặc định, 0ms) | onnx (~300MB) | api
EMBEDDING_L2=off              # off (mặc định dev 16GB) | e5-small-int8 | bge-m3-api
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# ── Observability profile ────────────────────────────────────────────
GRAFANA_PASSWORD=admin
