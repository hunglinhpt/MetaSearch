{
  "name": "metasearch-frontend",
  "version": "4.7.0",
  "license": "GPL-3.0-or-later",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "build:export": "node -e \"process.env.METASEARCH_UI_EXPORT='1';require('child_process').execSync('npm run build',{stdio:'inherit',shell:true})\"",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "katex": "^0.19.1",
    "lightweight-charts": "5.3.0",
    "mermaid": "^12.3.0",
    "next": "^15.1.0",
    "prismjs": "^1.30.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "@types/node": "^22.10.0",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "postcss": "^8.5.23"
  }
}
